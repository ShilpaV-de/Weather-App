# Copy this file to `.env` and fill in your key. Never commit `.env`.
# Get a free key at https://openweathermap.org/api

# Required — existing integration (OpenWeather current weather + forecast)
VITE_OPENWEATHER_API_KEY=your_api_key_here

# Optional — override the API base (defaults to https://api.openweathermap.org/data/2.5)
# VITE_OPENWEATHER_API_URL=https://api.openweathermap.org/data/2.5
